# Copy the values you need into your MCP client's "env" config.
# Never commit real keys.

# mock | openai | gemini | ollama  (mock needs no key)
MUSIC_LLM_PROVIDER=mock
# Optional; each provider has a default
MUSIC_LLM_MODEL=

OPENAI_API_KEY=
GEMINI_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# Where MIDI files are written (default: ~/music-llm-output)
MUSIC_LLM_OUTPUT_DIR=

# Guards
MUSIC_LLM_TIMEOUT=60
MUSIC_LLM_MAX_TOKENS=2000
MUSIC_LLM_MAX_CALLS=50
